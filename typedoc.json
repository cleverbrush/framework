{
    "$schema": "https://typedoc.org/schema.json",
    "entryPointStrategy": "packages",
    "packageOptions": {
        "tsconfig": "tsconfig.build.json"
    },
    "entryPoints": [
        "libs/async",
        "libs/auth",
        "libs/client",
        "libs/deep",
        "libs/di",
        "libs/env",
        "libs/knex-clickhouse",
        "libs/knex-schema",
        "libs/log",
        "libs/mapper",
        "libs/orm",
        "libs/orm-cli",
        "libs/otel",
        "libs/react-form",
        "libs/scheduler",
        "libs/scheduler-postgres",
        "libs/schema",
        "libs/schema-json",
        "libs/server",
        "libs/server-openapi",
        "libs/storage",
        "libs/storage-s3"
    ],
    "out": "websites/docs/public/api-docs/latest",
    "name": "Libraries",
    "highlightLanguages": [
        "bash", "console", "css", "html", "javascript", "json", "jsonc",
        "json5", "yaml", "tsx", "typescript", "sql"
    ],
    "excludePrivate": true,
    "exclude": ["**/node_modules/**", "websites/**", "demos/**"],
    "navigationLinks": {
        "← Back to Website": "/",
        "All Versions": "/api-docs/"
    }
}
